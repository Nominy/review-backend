{
  "name": "babel-review-backend",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "bun --no-env-file --watch src/index.ts",
    "start": "bun --no-env-file src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --max-concurrency=1",
    "eval:smoke": "bun --no-env-file src/run-smoke-eval.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs --update-env",
    "pm2:stop": "pm2 delete babel-review-backend",
    "pm2:logs": "pm2 logs babel-review-backend"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "diff-match-patch": "^1.0.5",
    "elysia": "^1.4.28"
  },
  "devDependencies": {
    "@types/diff-match-patch": "^1.0.36",
    "bun-types": "^1.3.13",
    "typescript": "^5.9.3"
  }
}
